# Copy this file to .env.local for local development.
# For production, these are injected by GitHub Actions (see .github/workflows/deploy.yml).

# Your backend URL — use localhost for dev, your Render URL for production
VITE_API_URL=http://localhost:3000

# The base path matching your GitHub repo name (used by GitHub Pages).
# For local dev, leave as /
# For GitHub Pages at https://<user>.github.io/muzix/, set to /muzix/
VITE_BASE_PATH=/
