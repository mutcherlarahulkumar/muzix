# Copy this file to .env and fill in all values before running the server.

# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com → your cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/muzix?retryWrites=true&w=majority

# JWT signing secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_here

# YouTube Data API v3 key
# Get it from: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Local dev + your GitHub Pages URL
ALLOWED_ORIGINS=http://localhost:5173,https://<your-github-username>.github.io

# Server port (Render sets this automatically; leave as 3000 for local dev)
PORT=3000
